# --- Groq -------------------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here
# Model ids are fixed in app/agents/llm.py - see README "Model note".

# --- Database (MySQL or Postgres via SQLAlchemy) -----------------------------
# Local Homebrew MySQL default: user root, no password, database "aivoa".
DATABASE_URL=mysql+pymysql://root@localhost:3306/aivoa
# Postgres alternative (a plain postgresql:// URL from Neon/Supabase works as-is):
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# --- CORS (JSON list of allowed browser origins) -----------------------------
CORS_ORIGINS=["http://localhost:5173"]
